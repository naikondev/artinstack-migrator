{
  "name": "@artinstack/migrator",
  "version": "0.1.14",
  "description": "Stateless content normalizer and migration framework — WordPress, SmugMug, Squarespace → platform-agnostic schema",
  "license": "MIT",
  "author": "ArtInStack",
  "homepage": "https://github.com/naikondev/artinstack-migrator#readme",
  "bugs": {
    "url": "https://github.com/naikondev/artinstack-migrator/issues"
  },
  "keywords": [
    "migration",
    "wordpress",
    "smugmug",
    "squarespace",
    "content",
    "normalizer",
    "wxr",
    "grapesjs"
  ],
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naikondev/artinstack-migrator.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./normalizer": {
      "types": "./dist/normalizer/index.d.ts",
      "import": "./dist/normalizer/index.js"
    },
    "./sinks": {
      "types": "./dist/sinks/index.d.ts",
      "import": "./dist/sinks/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./transformers": {
      "types": "./dist/transformers/index.d.ts",
      "import": "./dist/transformers/index.js"
    }
  },
  "bin": {
    "artinstack-migrate": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:validate-fixtures": "vitest run fixtures",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test",
    "cli": "node dist/cli/index.js",
    "migrate": "node dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.4.5",
    "vitest": "^3.0.0"
  }
}
